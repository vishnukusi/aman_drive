# Copy to .env to override. All values are optional; defaults are the details
# verified on https://amanselfdrivecars.com/ on 30 Oct 2026.

# WhatsApp number in international format, digits only (country code first).
VITE_WHATSAPP_NUMBER=919581378999
VITE_PHONE_DISPLAY=+91 95813 78999

# Demo admin credentials (client-side only - NOT real security).
VITE_ADMIN_USER=admin
VITE_ADMIN_PASS=driveflow

# Set to "false" to hide the delivery/pickup-at-address options in the booking flow.
VITE_DELIVERY_ENABLED=true
