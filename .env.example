# Copy to .env to override. All values are optional; defaults are the details
# verified on https://amanselfdrivecars.com/ (re-checked 9 Nov 2026).
# Everything prefixed VITE_ is compiled into the public JavaScript bundle: never put a secret here.

# WhatsApp number in international format, digits only (country code first).
VITE_WHATSAPP_NUMBER=919581378999
VITE_PHONE_DISPLAY=+91 95813 78999
VITE_EMAIL=keerthikumar007@gmail.com

# Preview/demo mode (default on). Shows the "Preview build" notice, the demo staff-dashboard link and the
# demo login hint. Set to false only after the client approves this build as their live website.
VITE_DEMO_MODE=true

# Public URL of the deployment, no trailing slash. When set: canonical/og:url tags, crawlable robots.txt and sitemap.xml.
# When empty: the build is marked noindex so a preview never competes with amanselfdrivecars.com in search.
VITE_SITE_URL=

# Enquiry channel: "whatsapp-link" (default, the only active channel). "driveflow" is reserved for an
# authorised DriveFlow integration and deliberately refuses to run until one exists (see docs/DRIVEFLOW_INTEGRATION.md).
VITE_ENQUIRY_CHANNEL=whatsapp-link

# Set to "false" to hide the delivery/pickup-at-address options in the booking flow.
VITE_DELIVERY_ENABLED=true

# ---------------------------------------------------------------------------------------------
# DriveFlow API (server-side only: never prefix these with VITE_, they must not reach the browser)
# ---------------------------------------------------------------------------------------------
# Database. Local default: file:./data/driveflow.db. Production: a hosted libSQL database (e.g. Turso).
DATABASE_URL=file:./data/driveflow.db
DATABASE_AUTH_TOKEN=
# 32+ random characters; required in production (signs staff sessions).
SESSION_SECRET=
# Demo mode (default on): seeds fictional enquiries and demo staff users admin / staff / viewer.
DEMO_MODE=true
DEMO_STAFF_PASSWORD=driveflow-demo
# Outside demo mode, the first admin account is created from this password on first start.
STAFF_ADMIN_PASSWORD=
# WhatsApp: manual (default, hand-off links) | meta (Cloud API, needs the values below) | mock (tests)
WHATSAPP_PROVIDER=manual
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_TEMPLATE_ENQUIRY_RECEIVED=
WHATSAPP_TEMPLATE_DETAILS_REQUIRED=
WHATSAPP_TEMPLATE_QUOTE_READY=
WHATSAPP_TEMPLATE_STATUS_UPDATE=
API_PORT=8787
